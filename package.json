{
  "name": "organator",
  "version": "2.2.0",
  "description": "O Control Plane Open-Source para fundadores de SaaS. Automatize o onboarding e o provisionamento de infraestrutura (AWS/Vercel/Docker) para clientes Enterprise.",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@babel/types": "^7.29.7",
    "es-abstract": "^1.24.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ioredis": "^6.0.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "lightningcss-linux-x64-gnu": "^1.33.0"
  },
  "overrides": {
    "find-my-way": "9.7.0",
    "fastify": "^5.12.5",
    "js-yaml@5": "5.4.2"
  }
}
