# ==========================================
# Configurações do Organator Cloud (Monorepo)
# ==========================================

# 1. Banco de Dados (PostgreSQL)
# Usado pelo Prisma em 'packages/core-models' e pelo 'control-plane-api'
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/organator_db?schema=public"

# 2. Filas e Mensageria (Redis + BullMQ)
# Usado pelo 'control-plane-api' (producer) e 'provisioner-worker' (consumer)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# 3. Autenticação JWT (Backend)
# Chave secreta usada pelo NestJS para assinar os tokens dos usuários
JWT_SECRET="super_secret_jwt_key_change_in_production"

# Em produção, JWT_SECRET deve ter ao menos 32 caracteres e não pode usar o
# valor de exemplo. Defina origins explícitas (sem *) para o CORS da API.
CORS_ORIGINS="http://localhost:3001"
# Limites por IP e por janela. /health tem um limite maior, mas permanece finito.
RATE_LIMIT_MAX="100"
HEALTH_RATE_LIMIT_MAX="1000"
RATE_LIMIT_WINDOW_MS="60000"
# Proxies reversos confiáveis para X-Forwarded-For (IPs, CIDRs ou os nomes
# loopback, linklocal, uniquelocal). Vazio = não confiar em proxies.
# Ex.: TRUST_PROXY="10.0.0.0/8" para um ingress na rede interna.
# TRUST_PROXY_HOPS (legado) > 0 equivale a "loopback,linklocal,uniquelocal".
TRUST_PROXY=""

# Obrigatória em produção: chave hexadecimal de 64 caracteres, entregue por
# um secret manager. Nunca use o valor de desenvolvimento em produção.
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# 4. NextAuth (Frontend)
# URL base do painel administrativo
NEXTAUTH_URL="http://localhost:3000"
# Gerado via: openssl rand -base64 32
NEXTAUTH_SECRET="super_secret_nextauth_key_change_in_production"

# 5. URLs da API (Frontend Next.js) — lidas em runtime, não no build.
# Endereço da API como o NAVEGADOR o enxerga (ex.: https://api.suaempresa.com).
PUBLIC_API_URL="http://localhost:3001"
# Endereço interno usado pelo servidor do painel (NextAuth, server actions).
# Opcional: sem ele, usa PUBLIC_API_URL.
API_URL="http://localhost:3001"
# NEXT_PUBLIC_API_URL ainda é aceita como fallback, mas fica fixada no build.

# 6. Integração Stripe (Pagamentos e Onboarding)
# Vazio = modo simulado (sem chamadas ao Stripe). Para testar de verdade, use as
# chaves do modo de teste do Dashboard: sk_test_... e whsec_... (stripe listen).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# URL pública do backoffice: destino do checkout (sucesso/cancelamento) e do
# portal de cobrança. Eventos do webhook: checkout.session.completed,
# invoice.payment_failed, customer.subscription.updated/deleted.
BACKOFFICE_URL="http://localhost:3000"

# E-mails transacionais: recuperação de senha e link de ativação do dono criado
# no checkout/painel. Sem SMTP_URL, em desenvolvimento o e-mail (com o link) vai
# para o log da API; em produção é descartado.
# SMTP_URL="smtps://usuario:senha@smtp.exemplo.com:465"
MAIL_FROM="Organator <no-reply@localhost>"

# Provedores de deploy (worker): com PROVIDER_SIMULATION=true, falhas e falta de
# credenciais de Vercel/AWS/VPS viram resultados simulados (demo). Sem a variável
# a simulação só vale fora de NODE_ENV=production.
# PROVIDER_SIMULATION=true

# Versões vigentes dos termos de uso e da política de privacidade: ao mudar,
# os usuários precisam aceitar de novo (consentimento versionado).
# TERMS_VERSION=2026-10
# PRIVACY_POLICY_VERSION=2026-10

# Retenção de dados (LGPD): dias até a purga diária de registros encerrados.
# Padrões entre parênteses; a auditoria usa AUDIT_RETENTION_DAYS (90).
# RETENTION_WEBHOOK_EVENTS_DAYS=90
# RETENTION_SESSIONS_DAYS=30          # sessões revogadas/expiradas
# RETENTION_PASSWORD_TOKENS_DAYS=7    # links de senha usados/expirados
# RETENTION_MFA_CHALLENGES_DAYS=1
# RETENTION_INVITATIONS_DAYS=90       # convites aceitos/revogados/expirados
# RETENTION_DATA_EXPORTS_DAYS=30      # registros de exportações vencidas/falhas
# RETENTION_BACKUPS_DAYS=7

# 7. Identity Provider — VoidAuth (SSO/OIDC + MFA)
# URL pública da instância VoidAuth (docker-compose expõe em http://localhost:3003)
VOIDAUTH_URL="http://localhost:3003"
# Cliente OIDC criado no VoidAuth com redirect para o backoffice
VOIDAUTH_CLIENT_ID="organator-web"
VOIDAUTH_CLIENT_SECRET="oidc_client_secret"
# Issuer exposto pelo VoidAuth (formato {VOIDAUTH_URL}/oidc)
VOIDAUTH_ISSUER="http://localhost:3003/oidc"
# Token de administração do VoidAuth (usado para convidar OWNERs em tenants novos)
VOIDAUTH_ADMIN_TOKEN="voidauth_admin_token"
# Chave de armazenamento interna do VoidAuth (troque em produção)
VOIDAUTH_STORAGE_KEY="dev_storage_key_change_me"

# 8. Modo de autenticação do Control Plane API
# legacy | oidc | both (padrão: both — aceita JWT próprio e tokens OIDC durante a migração)
AUTH_MODE="both"
# Bloqueio de conta após senhas erradas consecutivas (resposta continua genérica).
LOGIN_MAX_FAILED_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"

# Logs da API: json (uma linha por evento + log de acesso com request id; padrão
# em produção) ou pretty (texto colorido; padrão em desenvolvimento).
LOG_FORMAT="pretty"
# error | warn | info | debug | trace
LOG_LEVEL="info"
# Documentação OpenAPI em /docs (UI) e /docs/openapi.json. Ligada por padrão
# fora de produção; em produção só com "true".
API_DOCS_ENABLED="true"

# 9. Seed do Admin default (criado no 1º boot com senha temporária impressa nos logs)
PLATFORM_ADMIN_EMAIL="admin@organator.app"

# 10. Tenant Data Plane Isolation (#49) — lido pelo provisioner-worker.
# Desligado por padrão: as reconciliações são ignoradas sem tocar em banco.
DATA_ISOLATION_ENABLED="false"
# Postgres do DATA PLANE (onde ficam os dados dos tenants do seu produto), com
# privilégio para CREATE ROLE/DATABASE. Use um servidor/banco separado do
# control plane em produção.
DATA_ISOLATION_ADMIN_URL="postgresql://organator:password@localhost:5433/organator_db"
# Tabelas do produto com escopo de tenant (JSON). schema/tenantColumn/primaryKey
# são opcionais (padrão public / tenant_id / id). Em SCHEMA/DATABASE a estrutura
# é copiada automaticamente da tabela compartilhada.
DATA_ISOLATION_TABLES='[{"table":"orders"},{"table":"invoices","tenantColumn":"account_id"}]'
# Horas antes da limpeza da origem após uma migração (janela de rollback).
DATA_ISOLATION_ROLLBACK_HOURS="24"
