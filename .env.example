# ==========================================
# Configurações do Organator Cloud (Monorepo)
# ==========================================

# 1. Banco de Dados (PostgreSQL)
# Usado pelo Prisma em 'packages/core-models' e pelo 'control-plane-api'
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/organator_db?schema=public"

# 2. Filas e Mensageria (Redis + BullMQ)
# Usado pelo 'control-plane-api' (producer) e 'provisioner-worker' (consumer)
REDIS_HOST="localhost"
REDIS_PORT="6379"

# 3. Autenticação JWT (Backend)
# Chave secreta usada pelo NestJS para assinar os tokens dos usuários
JWT_SECRET="super_secret_jwt_key_change_in_production"

# 4. NextAuth (Frontend)
# URL base do painel administrativo
NEXTAUTH_URL="http://localhost:3000"
# Gerado via: openssl rand -base64 32
NEXTAUTH_SECRET="super_secret_nextauth_key_change_in_production"

# 5. URLs das APIs (Frontend Next.js)
# URL onde o Control Plane API (NestJS) está rodando
NEXT_PUBLIC_API_URL="http://localhost:3001/v1"

# 6. Integração Stripe (Pagamentos e Onboarding)
# Substitua com suas chaves de teste (Modo Teste) geradas no Dashboard da Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# 7. Identity Provider — VoidAuth (SSO/OIDC + MFA)
# URL pública da instância VoidAuth (docker-compose expõe em http://localhost:3003)
VOIDAUTH_URL="http://localhost:3003"
# Cliente OIDC criado no VoidAuth com redirect para o backoffice
VOIDAUTH_CLIENT_ID="organator-web"
VOIDAUTH_CLIENT_SECRET="oidc_client_secret"
# Issuer exposto pelo VoidAuth (formato {VOIDAUTH_URL}/oidc)
VOIDAUTH_ISSUER="http://localhost:3003/oidc"
# Token de administração do VoidAuth (usado para convidar OWNERs em tenants novos)
VOIDAUTH_ADMIN_TOKEN="voidauth_admin_token"
# Chave de armazenamento interna do VoidAuth (troque em produção)
VOIDAUTH_STORAGE_KEY="dev_storage_key_change_me"

# 8. Modo de autenticação do Control Plane API
# legacy | oidc | both (padrão: both — aceita JWT próprio e tokens OIDC durante a migração)
AUTH_MODE="both"

# 9. Seed do Admin default (criado no 1º boot com senha temporária impressa nos logs)
PLATFORM_ADMIN_EMAIL="admin@organator.app"
