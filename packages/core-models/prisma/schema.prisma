generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  stripeId  String?  @unique // Stripe Customer ID
  plan      String   @default("free")
  status    String   @default("active") // active | suspended | archived
  // Máquina de estados dirigida por eventos de pagamento (#46)
  state         String    @default("active") // onboarding | active | past_due | suspended | offboarding | deleted
  graceEndsAt   DateTime? // fim do período de graça quando past_due
  suspendedAt   DateTime? // quando foi suspenso
  stateChangedAt DateTime? // última transição de estado
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  microservices Microservice[]
  iamGroups    IamGroup[]
  apiKeys      ApiKey[]
  entitlementOverride TenantEntitlementOverride?
  securityPolicy TenantSecurityPolicy?
  placementPolicy TenantPlacementPolicy?
  placementMigrations TenantPlacementMigration[]
  providerProfiles ProviderProfile[]
  domains Domain[]
  deployments Deployment[]
  invitations TenantInvitation[]
}

model RegionCatalog {
  id          String   @id @default(uuid())
  provider    String
  region      String
  residency   String
  capacity    Int      @default(0)
  status      String   @default("available") // available | degraded | unavailable
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  policies    TenantPlacementPolicy[]

  @@unique([provider, region])
  @@index([status, residency])
  @@map("region_catalog")
}

model TenantPlacementPolicy {
  id                String        @id @default(uuid())
  tenantId          String        @unique
  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  regionId          String?
  region            RegionCatalog? @relation(fields: [regionId], references: [id])
  residencyRequired String?
  allowedProviders  Json          @default("[]")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([regionId])
  @@map("tenant_placement_policies")
}

model TenantPlacementMigration {
  id              String   @id @default(uuid())
  tenantId        String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fromRegionId    String?
  toRegionId      String
  status          String   @default("planned") // planned | approved | running | completed | rolled_back | failed
  rollbackPlan    Json     @default("{}")
  affectedData    Json     @default("{}")
  backupReference String?
  approvedBy      String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, status])
  @@map("tenant_placement_migrations")
}

// Tokens de serviço para automação (CI/CD, SDKs) — o token bruto só é
// exibido na criação; no banco fica apenas o hash sha256 (#33).
model ApiKey {
  id         String   @id @default(uuid())
  name       String
  hash       String   @unique // sha256 hex do token sk_... (nunca em claro)
  prefix     String   // identificador público exibido na listagem (ex.: sk_a1b2c3)
  scopes     Json     @default("[]") // array de escopos, ex.: ["services:write"]
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  createdBy  String?
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  @@map("api_keys")
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?  // quem executou (null = sistema/webhook)
  actorEmail   String?
  action       String   // ex.: tenant.state_change, tenant.plan_change
  resourceType String   // ex.: Tenant
  resourceId   String?
  changes      Json     @default("{}") // diff { from, to }
  ip           String?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

model WebhookEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique // Stripe event id (idempotência)
  type        String
  tenantId    String?
  payload     Json     @default("{}")
  processedAt DateTime @default(now())

  @@map("webhook_events")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String   // Hashed password
  name                String?
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  role                String   @default("MEMBER") // PLATFORM_ADMIN, ADMIN, OWNER, MEMBER
  mustChangePassword  Boolean  @default(false) // força troca de senha no 1º login
  authProvider        String   @default("credentials") // credentials | oidc
  externalId          String?  // sub do IdP (VoidAuth)
  mfaEnabled          Boolean  @default(false) // TOTP app-level
  mfaSecretEncrypted  String?  // segredo TOTP cifrado
  mfaFailedAttempts   Int      @default(0)
  mfaLockedUntil      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  mfaChallenges       MfaChallenge[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  sessions            UserSession[]
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  lastSeenAt   DateTime @default(now())
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, revokedAt, expiresAt])
  @@map("user_sessions")
}

model TenantInvitation {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email       String
  role        String   @default("MEMBER")
  tokenHash   String   @unique
  invitedBy   String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId, email, acceptedAt])
  @@index([expiresAt])
  @@map("tenant_invitations")
}

model TenantSecurityPolicy {
  id           String   @id @default(uuid())
  tenantId     String   @unique
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  mfaMode      String   @default("optional") // optional | required_for_roles | required_for_all
  requiredRoles Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tenant_security_policies")
}

model MfaChallenge {
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  tenantId   String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  attempts   Int      @default(0)
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([tenantId, expiresAt])
  @@map("mfa_challenges")
}

model MfaRecoveryCode {
  id         String   @id @default(uuid())
  userId     String
  codeHash   String
  usedAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("mfa_recovery_codes")
}

model IamGroup {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   // ex.: tenant-{slug}
  createdAt DateTime @default(now())
  @@unique([tenantId, name])
}

model Microservice {
  id          String   @id @default(uuid())
  name        String
  repository  String?
  environment String   @default("production")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  deployments Deployment[]
  apiDocs     ApiDoc[]
  cloudProvider String // 'AWS', 'VERCEL', 'VPS'
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  domains     Domain[]
}

model Domain {
  id             String        @id @default(uuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  microserviceId String?
  microservice   Microservice? @relation(fields: [microserviceId], references: [id], onDelete: SetNull)
  hostname       String        @unique
  provider       String
  dnsRecordId    String?
  status         String        @default("pending")
  tlsStatus      String        @default("pending")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenantId, status])
  @@index([microserviceId])
  @@map("domains")
}

model ApiDoc {
  id             String   @id @default(uuid())
  microserviceId String
  microservice   Microservice @relation(fields: [microserviceId], references: [id])
  title          String
  version        String
  openApiSpec    String   @db.Text // JSON stringificado da spec OpenAPI
  isPublic       Boolean  @default(false) // Configurável Público ou Privado
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Deployment {
  id             String   @id @default(uuid())
  microserviceId String?
  microservice   Microservice? @relation(fields: [microserviceId], references: [id])
  tenantId       String?
  tenant         Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  status         String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  environment    String   @default("production") // production | staging | development
  phase          String   @default("DB") // DB, NETWORK, DNS, DONE, DEPROVISION
  logs           String?
  resourceState  Json     @default("{}")
  idempotencyKey String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([tenantId, environment, status])
}

model BillingPlan {
  slug            String   @id // slug do plano, ex.: free | pro | enterprise
  name            String
  description     String?
  price           Int      @default(0) // preço em centavos (0 = gratuito)
  currency        String   @default("usd")
  cycle           String   @default("monthly") // monthly | yearly
  quotas          Json     @default("{}") // ex.: {"MICROSERVICE": 2, "DEPLOYMENT": 5} (-1 = ilimitado)
  features        Json     @default("{}") // feature flags, ex.: {"api_keys": true, "sso_saml": false}
  limitTypes      Json     @default("{}") // tipo de limite por recurso, ex.: {"MICROSERVICE": "hard", "SEATS": "soft"}
  status          String   @default("active") // active | inactive
  sortOrder       Int      @default(0)
  stripeProductId String?
  stripePriceId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("billing_plans")
}

// Credenciais de provedores de nuvem (AWS | VERCEL | VPS) — os segredos são
// cifrados com AES-256-GCM via ENCRYPTION_KEY; leitura nunca expõe o segredo (#31).
model ProviderCredential {
  id            String   @id @default(uuid())
  type          String   // AWS | VERCEL | VPS
  name          String   // nome amigável, ex.: "AWS principal"
  encryptedData Json     // segredos cifrados, ex.: { accessKeyId: <enc>, secretAccessKey: <enc> } | { apiToken: <enc> } | { privateKey: <enc> }
  config        Json     @default("{}") // não-secretos: { region, teamId, host, port, username, domain, network }
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  profiles      ProviderProfile[]

  @@unique([type, name])
  @@map("provider_credentials")
}

model ProviderProfile {
  id           String             @id @default(uuid())
  name         String
  type         String             // AWS | VERCEL | VPS
  tenantId     String?
  tenant       Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  credentialId String
  credential   ProviderCredential @relation(fields: [credentialId], references: [id])
  config       Json               @default("{}")
  isDefault    Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([tenantId, name])
  @@index([tenantId, type, isDefault])
  @@map("provider_profiles")
}

// Overrides de entitlements por tenant (ex.: crédito de cortesia) sem alterar o plano.
model TenantEntitlementOverride {
  id        String   @id @default(uuid())
  tenantId  String   @unique
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  quotas    Json     @default("{}") // ex.: {"MICROSERVICE": 10} (-1 = ilimitado)
  features  Json     @default("{}") // ex.: {"api_keys": true}
  limits    Json     @default("{}") // ex.: {"SEATS": "soft"}
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenant_entitlement_overrides")
}
