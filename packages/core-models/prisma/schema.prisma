generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  stripeId  String?  @unique // Stripe Customer ID
  plan      String   @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  microservices Microservice[]
  iamGroups    IamGroup[]
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  password            String   // Hashed password
  name                String?
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  role                String   @default("MEMBER") // PLATFORM_ADMIN, ADMIN, OWNER, MEMBER
  mustChangePassword  Boolean  @default(false) // força troca de senha no 1º login
  authProvider        String   @default("credentials") // credentials | oidc
  externalId          String?  // sub do IdP (VoidAuth)
  mfaEnabled          Boolean  @default(false) // TOTP app-level
  mfaSecretEncrypted  String?  // segredo TOTP cifrado
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model IamGroup {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String   // ex.: tenant-{slug}
  createdAt DateTime @default(now())
  @@unique([tenantId, name])
}

model Microservice {
  id          String   @id @default(uuid())
  name        String
  repository  String?
  environment String   @default("production")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  deployments Deployment[]
  apiDocs     ApiDoc[]
  cloudProvider String // 'AWS', 'VERCEL', 'VPS'
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiDoc {
  id             String   @id @default(uuid())
  microserviceId String
  microservice   Microservice @relation(fields: [microserviceId], references: [id])
  title          String
  version        String
  openApiSpec    String   @db.Text // JSON stringificado da spec OpenAPI
  isPublic       Boolean  @default(false) // Configurável Público ou Privado
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Deployment {
  id             String   @id @default(uuid())
  microserviceId String
  microservice   Microservice @relation(fields: [microserviceId], references: [id])
  status         String   @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED
  logs           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BillingPlan {
  slug            String   @id // slug do plano, ex.: free | pro | enterprise
  name            String
  description     String?
  price           Int      @default(0) // preço em centavos (0 = gratuito)
  currency        String   @default("usd")
  cycle           String   @default("monthly") // monthly | yearly
  quotas          Json     @default("{}") // ex.: {"MICROSERVICE": 2, "DEPLOYMENT": 5} (-1 = ilimitado)
  features        Json     @default("{}") // feature flags, ex.: {"apiKeys": true, "sso": false}
  status          String   @default("active") // active | inactive
  sortOrder       Int      @default(0)
  stripeProductId String?
  stripePriceId   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("billing_plans")
}
